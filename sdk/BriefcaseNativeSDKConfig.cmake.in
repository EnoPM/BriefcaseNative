get_filename_component(_bc_sdk "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
if(NOT TARGET Briefcase::ModApi)
 add_library(Briefcase::ModApi INTERFACE IMPORTED)
 set_target_properties(Briefcase::ModApi PROPERTIES INTERFACE_INCLUDE_DIRECTORIES "${_bc_sdk}/include" INTERFACE_COMPILE_FEATURES cxx_std_23)
 if(WIN32)
  set_property(TARGET Briefcase::ModApi PROPERTY INTERFACE_COMPILE_DEFINITIONS "UNICODE;_UNICODE;WIN32_LEAN_AND_MEAN;NOMINMAX")
 endif()
 if(MSVC)
  set_property(TARGET Briefcase::ModApi PROPERTY INTERFACE_COMPILE_OPTIONS "/EHsc;/utf-8")
 endif()
 add_library(Briefcase::Json INTERFACE IMPORTED)
 set_target_properties(Briefcase::Json PROPERTIES INTERFACE_INCLUDE_DIRECTORIES "${_bc_sdk}/third_party/include")
endif()
set(BriefcaseNativeSDK_VERSION "@VERSION@")
