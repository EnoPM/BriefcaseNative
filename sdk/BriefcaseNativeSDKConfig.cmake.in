get_filename_component(_bc_sdk "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
if(NOT TARGET Briefcase::ModApi)
 add_library(Briefcase::ModApi INTERFACE IMPORTED)
 set_target_properties(Briefcase::ModApi PROPERTIES INTERFACE_INCLUDE_DIRECTORIES "${_bc_sdk}/include" INTERFACE_COMPILE_FEATURES cxx_std_23)
 if(WIN32)
  set_property(TARGET Briefcase::ModApi PROPERTY INTERFACE_COMPILE_DEFINITIONS "UNICODE;_UNICODE;WIN32_LEAN_AND_MEAN;NOMINMAX")
 endif()
 if(MSVC)
  set_property(TARGET Briefcase::ModApi PROPERTY INTERFACE_COMPILE_OPTIONS "/EHsc;/utf-8")
 endif()
 add_library(Briefcase::Json INTERFACE IMPORTED)
 set_target_properties(Briefcase::Json PROPERTIES INTERFACE_INCLUDE_DIRECTORIES "${_bc_sdk}/third_party/include")
endif()
set(BriefcaseNativeSDK_VERSION "@VERSION@")

# Optional typed game API, compiled into the consuming module through the public C ABI.
if(NOT TARGET Briefcase::DeceiveInc)
 add_library(Briefcase.DeceiveInc.SDK STATIC EXCLUDE_FROM_ALL "${_bc_sdk}/src/DeceiveInc/Spy.cpp")
 target_link_libraries(Briefcase.DeceiveInc.SDK PUBLIC Briefcase::ModApi)
 set_target_properties(Briefcase.DeceiveInc.SDK PROPERTIES POSITION_INDEPENDENT_CODE ON)
 add_library(Briefcase::DeceiveInc ALIAS Briefcase.DeceiveInc.SDK)
endif()

# Linux modules keep C++ allocation local; Unreal exports a different allocator.
if(CMAKE_SYSTEM_NAME STREQUAL "Linux")
 execute_process(COMMAND "${CMAKE_CXX_COMPILER}" -print-file-name=libstdc++.a
   OUTPUT_VARIABLE _bc_cpp_runtime OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
 if(NOT EXISTS "${_bc_cpp_runtime}")
  message(FATAL_ERROR "The Linux mod SDK requires the static libstdc++ runtime")
 endif()
 set_property(TARGET Briefcase::ModApi APPEND PROPERTY INTERFACE_LINK_OPTIONS
   "-Wl,-Bsymbolic" "-Wl,--exclude-libs,ALL" "-static-libstdc++" "-static-libgcc")
 set_property(TARGET Briefcase::ModApi APPEND PROPERTY INTERFACE_LINK_LIBRARIES
   "-Wl,--whole-archive" "${_bc_cpp_runtime}" "-Wl,--no-whole-archive")
endif()
