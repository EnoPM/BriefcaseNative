add_library(Briefcase.NativeHello SHARED samples/Briefcase.NativeHello/Hello.cpp)
target_link_libraries(Briefcase.NativeHello PRIVATE Briefcase.ModApi)
set_target_properties(Briefcase.NativeHello PROPERTIES PREFIX "" CXX_VISIBILITY_PRESET hidden)
add_executable(Briefcase.LinuxNativeContracts tests/LinuxNativeContracts.cpp)
target_link_libraries(Briefcase.LinuxNativeContracts PRIVATE Briefcase.Admin.Service)
enable_testing()
add_test(NAME LinuxNativeContracts COMMAND Briefcase.LinuxNativeContracts)
add_test(NAME AdminManagementContracts COMMAND Briefcase.AdminManagementContracts)
add_test(NAME AdminContracts COMMAND Briefcase.AdminContracts)
set_tests_properties(AdminContracts PROPERTIES TIMEOUT 60)
add_test(NAME AdminTransportContracts COMMAND Briefcase.AdminTransportContracts)
set_tests_properties(AdminTransportContracts PROPERTIES TIMEOUT 30)
foreach(pair "Contracts;NativeContracts" "ReflectionContracts;ReflectionContracts"
             "PortableServerContracts;PortableServerContracts" "LibraryContracts;LibraryContracts")
  list(GET pair 0 source)
  list(GET pair 1 test)
  add_executable(Briefcase.${source} tests/${source}.cpp)
  target_link_libraries(Briefcase.${source} PRIVATE Briefcase.Core Briefcase.Localization ${CMAKE_DL_LIBS})
  if(source STREQUAL "LibraryContracts")
    add_dependencies(Briefcase.${source} Briefcase.NativeHello)
    add_test(NAME ${test} COMMAND Briefcase.${source} "$<TARGET_FILE:Briefcase.NativeHello>")
  else()
    add_test(NAME ${test} COMMAND Briefcase.${source})
  endif()
endforeach()
