# Optional offline diagnostic. The caller supplies a separately built, pinned Linux
# patternsleuth_bind archive; this does not select a production Unreal backend.
set(BRIEFCASE_LINUX_SCANNER_LIBRARY "" CACHE FILEPATH "Experimental Linux patternsleuth_bind static library")
if(BRIEFCASE_LINUX_SCANNER_LIBRARY)
  if(NOT EXISTS "${BRIEFCASE_LINUX_SCANNER_LIBRARY}")
    message(FATAL_ERROR "Linux scanner library does not exist")
  endif()
  add_executable(Briefcase.LinuxUnrealScan tools/LinuxUnrealScan.cpp)
  target_link_libraries(Briefcase.LinuxUnrealScan PRIVATE nlohmann_json::nlohmann_json
    "${BRIEFCASE_LINUX_SCANNER_LIBRARY}" Threads::Threads ${CMAKE_DL_LIBS} m util rt)
  add_test(NAME LinuxUnrealScanContracts COMMAND "${Python3_EXECUTABLE}"
    "${CMAKE_SOURCE_DIR}/tests/LinuxUnrealScanContracts.py" "$<TARGET_FILE:Briefcase.LinuxUnrealScan>")
  set_tests_properties(LinuxUnrealScanContracts PROPERTIES TIMEOUT 60)
endif()
